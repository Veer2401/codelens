{
  "manifest_version": 3,
  "name": "CodeLens - Complexity Visualizer",
  "version": "1.0.0",
  "description": "Real-time code complexity analysis with beautiful visualizations for web-based editors - Supports JavaScript, Python, Java, C++, HTML, CSS and more",
  "permissions": [
    "activeTab",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://github.com/*",
    "https://codesandbox.io/*",
    "https://stackblitz.com/*",
    "https://replit.com/*",
    "https://jsfiddle.net/*",
    "https://codepen.io/*",
    "https://gitlab.com/*",
    "https://bitbucket.org/*",
    "https://sourceforge.net/*",
    "https://pastebin.com/*",
    "https://gist.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*",
        "https://codesandbox.io/*",
        "https://stackblitz.com/*",
        "https://replit.com/*",
        "https://jsfiddle.net/*",
        "https://codepen.io/*",
        "https://gitlab.com/*",
        "https://bitbucket.org/*",
        "https://sourceforge.net/*",
        "https://pastebin.com/*",
        "https://gist.github.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CodeLens - Complexity Visualizer"
  },
  "web_accessible_resources": [
    {
      "resources": ["widget.html", "widget.css", "widget.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
