{
  "manifest_version": 3,
  "name": "CodeLens - Complexity Visualizer",
  "version": "1.0.0",
  "description": "Real-time code complexity analysis with beautiful visualizations for web editors. Supports JS, Python, Java, C++, HTML, CSS",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "contextMenus",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "https://github.com/*",
    "https://codesandbox.io/*",
    "https://stackblitz.com/*",
    "https://replit.com/*",
    "https://jsfiddle.net/*",
    "https://codepen.io/*",
    "https://gitlab.com/*",
    "https://bitbucket.org/*",
    "https://sourceforge.net/*",
    "https://pastebin.com/*",
    "https://gist.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*",
        "https://codesandbox.io/*",
        "https://stackblitz.com/*",
        "https://replit.com/*",
        "https://jsfiddle.net/*",
        "https://codepen.io/*",
        "https://gitlab.com/*",
        "https://bitbucket.org/*",
        "https://sourceforge.net/*",
        "https://pastebin.com/*",
        "https://gist.github.com/*"
      ],
      "js": ["assets/esprima.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_end",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CodeLens - Complexity Visualizer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["widget.html", "widget.css", "widget.js", "assets/esprima.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
